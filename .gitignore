# build output
dist/
# CI-only build that keeps /dev/* (DN_DEV_PAGES=1); never deployed
dist-dev/
# generated types
.astro/
# wrangler local state
.wrangler/
# wrangler local secrets (never committed; `wrangler dev` reads these)
.dev.vars*
# check reports (e.g. reports/a11y/, reports/lhci/)
reports/
# Lighthouse CI's own scratch directory (reports/lhci/ is the real output)
.lighthouseci/

# dependencies
node_modules/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*


# environment variables (.env, .env.local, .env.production, .env.production.local, ...)
.env*

# macOS-specific files
.DS_Store

# jetbrains setting folder
.idea/
