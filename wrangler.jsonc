{
	"$schema": "node_modules/wrangler/config-schema.json",
	// Throwaway branch for testing Workers Builds with Worker Previews. Not for
	// merge. One Worker: `prod` runs `wrangler deploy`, every other branch runs
	// `wrangler preview`, which never applies routes or custom domains.
	"name": "website",
	"compatibility_date": "2026-09-23",

	"assets": {
		"directory": "./dist",
		"not_found_handling": "404-page",
		"html_handling": "auto-trailing-slash"
	},

	"routes": [{ "pattern": "davidanunez.com", "custom_domain": true }],
	"workers_dev": false,
	// workers.dev Preview URLs, behind Cloudflare Access.
	"preview_urls": true,
	// Required by `wrangler preview`. Empty: a static site has no bindings.
	"previews": {}
}
