{
	"$schema": "node_modules/wrangler/config-schema.json",
	// Fully static site (Astro's default `output: "static"`, no
	// `@astrojs/cloudflare` adapter): there's no Worker script to run, so
	// there's no `main` here either. Wrangler serves `assets.directory`
	// directly and asset requests never invoke a Worker.
	"name": "website",
	"compatibility_date": "2026-09-23",

	"assets": {
		"directory": "./dist",
		// The nearest `404.html` with a 404 status, once a parallel PR adds
		// `src/pages/404.astro`.
		"not_found_handling": "404-page",
		// Default value, set explicitly: files serve without a trailing slash,
		// folder `index.html` files serve with one (redirecting the other form),
		// matching directory-format output and `trailingSlash: "always"`.
		"html_handling": "auto-trailing-slash"
	},

	// Public on the default (*.workers.dev) subdomain. Neither flag is
	// applied by `wrangler versions upload` (deploy.yml's preview job) —
	// only a `wrangler deploy` or `wrangler triggers deploy` against this
	// target turns them on server-side, which first happens on staging's
	// initial `wrangler deploy --env=""`. Until then, every preview upload
	// fails with "did not report a preview_alias_url": the Worker has no
	// subdomain to publish a preview on yet. Cloudflare Access must be set
	// on the `website` Worker (All traffic, not the account-wide option —
	// that would also gate production) before that first staging deploy,
	// so the window where this subdomain is briefly live and unprotected
	// stays as short as possible. Production stays off (below).
	"workers_dev": true,
	"preview_urls": true,

	// The production target. D3 deploys it on pushes to `prod`; until then,
	// `wrangler deploy --env production` (or a plain `wrangler deploy` with
	// `CLOUDFLARE_ENV=production` set) is the only thing that would touch it.
	"env": {
		"production": {
			"routes": [{ "pattern": "davidanunez.com", "custom_domain": true }],
			"workers_dev": false,
			"preview_urls": false
		}
	}
}
