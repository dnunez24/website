# Browser caching for Workers static assets. Unmatched files keep the
# platform default, `public, max-age=0, must-revalidate` plus an ETag.
# Docs: https://developers.cloudflare.com/workers/static-assets/headers/
#
# HTML, robots.txt, the sitemaps and rss.xml stay on that default: their
# URLs don't change, so revalidating beats pinning them to hashed files a
# deploy might remove.
#
# Caveat: a missing /_astro/* file's 404 gets `immutable` too. Low risk on
# an atomic `wrangler deploy`, except after a rollback or a revert that
# revives an old filename: a browser that cached that 404 in the gap
# keeps it a year. Roll forward, not back. Not safe with gradual
# rollouts, which can pair new HTML with old assets on any request.

/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/favicon.ico
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/favicon.svg
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/apple-touch-icon.png
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/og/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
