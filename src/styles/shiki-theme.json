{
	"name": "website",
	"displayName": "Website",
	"type": "light",
	"semanticHighlighting": false,
	"colors": {
		"editor.background": "#cccfd2",
		"editor.foreground": "#1c2023",
		"editor.selectionBackground": "#fcdbc2",
		"editor.selectionForeground": "#0b0e11",
		"editor.inactiveSelectionBackground": "#dcdee1",
		"editor.lineHighlightBackground": "#dcdee1",
		"editorCursor.foreground": "#7a3518",
		"editorLineNumber.foreground": "#7a7e83",
		"editorLineNumber.activeForeground": "#41464b",
		"editorWhitespace.foreground": "#a0a3a7",
		"editorIndentGuide.background1": "#a0a3a7",
		"editorIndentGuide.activeBackground1": "#7a7e83",
		"editorGutter.background": "#cccfd2",
		"editorRuler.foreground": "#a0a3a7",
		"editorBracketMatch.background": "#dcdee1",
		"editorBracketMatch.border": "#7a7e83",
		"focusBorder": "#7a3518"
	},
	"settings": [
		{
			"name": "plain — identifiers, functions, types, properties, operators",
			"scope": [
				"source",
				"variable",
				"variable.other",
				"variable.other.readwrite",
				"variable.other.property",
				"variable.parameter",
				"entity.name.function",
				"entity.name.type",
				"entity.name.class",
				"entity.name.namespace",
				"entity.name.label",
				"support.function",
				"support.class",
				"support.type",
				"support.variable",
				"support.type.property-name",
				"meta.object-literal.key",
				"entity.other.attribute-name",
				"entity.other.inherited-class",
				"keyword.operator",
				"keyword.operator.assignment",
				"keyword.operator.arithmetic",
				"keyword.operator.comparison",
				"keyword.operator.logical",
				"invalid",
				"invalid.illegal",
				"invalid.deprecated",
				"markup.inserted",
				"markup.deleted",
				"markup.changed",
				"markup.underline.link",
				"string.other.link"
			],
			"settings": { "foreground": "#1c2023" }
		},
		{
			"name": "muted — comments and punctuation",
			"scope": [
				"punctuation",
				"punctuation.separator",
				"punctuation.terminator",
				"punctuation.accessor",
				"punctuation.section",
				"punctuation.definition.parameters",
				"punctuation.definition.block",
				"punctuation.definition.tag",
				"punctuation.definition.list_item",
				"meta.brace",
				"meta.delimiter",
				"markup.quote"
			],
			"settings": { "foreground": "#53575c" }
		},
		{
			"name": "muted italic — comments",
			"scope": [
				"comment",
				"comment.line",
				"comment.block",
				"comment.block.documentation",
				"punctuation.definition.comment",
				"string.comment"
			],
			"settings": { "foreground": "#53575c", "fontStyle": "italic" }
		},
		{
			"name": "keyword (clay) — keywords, storage, language constants, tags",
			"scope": [
				"keyword",
				"keyword.control",
				"keyword.control.flow",
				"keyword.control.import",
				"keyword.control.conditional",
				"keyword.other",
				"keyword.other.important",
				"keyword.declaration",
				"keyword.operator.new",
				"keyword.operator.expression",
				"keyword.operator.instanceof",
				"keyword.operator.of",
				"keyword.operator.in",
				"keyword.operator.typeof",
				"storage",
				"storage.type",
				"storage.modifier",
				"constant.language",
				"constant.language.boolean",
				"constant.language.null",
				"constant.language.undefined",
				"variable.language",
				"variable.language.this",
				"variable.language.super",
				"entity.name.tag",
				"meta.at-rule keyword",
				"markup.heading",
				"markup.bold",
				"entity.name.section"
			],
			"settings": { "foreground": "#7a3518" }
		},
		{
			"name": "literal (verdigris) — strings, numbers, escapes, raw markup",
			"scope": [
				"string",
				"string.quoted",
				"string.quoted.single",
				"string.quoted.double",
				"string.quoted.triple",
				"string.template",
				"string.unquoted",
				"string.regexp",
				"punctuation.definition.string",
				"punctuation.definition.string.begin",
				"punctuation.definition.string.end",
				"constant.numeric",
				"constant.character",
				"constant.character.escape",
				"constant.other",
				"constant.other.color",
				"constant.other.symbol",
				"support.constant",
				"keyword.other.unit",
				"entity.other.attribute-name.value",
				"markup.inline.raw",
				"markup.raw",
				"markup.fenced_code"
			],
			"settings": { "foreground": "#1b4c52" }
		},
		{
			"name": "emphasis — italic only, never a hue",
			"scope": ["markup.italic", "emphasis"],
			"settings": { "fontStyle": "italic" }
		}
	]
}
