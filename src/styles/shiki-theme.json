{
	"name": "website",
	"displayName": "website",
	"type": "dark",
	"semanticHighlighting": false,
	"colors": {
		"editor.background": "var(--color-codeblock-ground)",
		"editor.foreground": "var(--color-syntax-plain)"
	},
	"settings": [
		{
			"settings": {
				"foreground": "var(--color-syntax-plain)",
				"background": "var(--color-codeblock-ground)"
			}
		},
		{
			"name": "comment",
			"scope": ["comment", "punctuation.definition.comment", "string.comment"],
			"settings": {
				"foreground": "var(--color-syntax-comment)",
				"fontStyle": "italic"
			}
		},
		{
			"name": "punctuation",
			"scope": [
				"punctuation",
				"meta.brace",
				"keyword.operator",
				"storage.type.function.arrow",
				"meta.tag.sgml punctuation"
			],
			"settings": {
				"foreground": "var(--color-syntax-punctuation)"
			}
		},
		{
			"name": "keyword",
			"scope": [
				"keyword",
				"keyword.control",
				"storage",
				"storage.type",
				"storage.modifier",
				"keyword.operator.new",
				"keyword.operator.expression",
				"variable.language.this",
				"variable.language.super"
			],
			"settings": {
				"foreground": "var(--color-syntax-keyword)",
				"fontStyle": "bold"
			}
		},
		{
			"name": "string",
			"scope": [
				"string",
				"string.template",
				"punctuation.definition.string",
				"markup.inline.raw",
				"string.regexp"
			],
			"settings": {
				"foreground": "var(--color-syntax-string)"
			}
		},
		{
			"name": "number",
			"scope": [
				"constant.numeric",
				"constant.language",
				"constant.character",
				"constant.other",
				"support.constant",
				"variable.other.constant",
				"variable.other.enummember"
			],
			"settings": {
				"foreground": "var(--color-syntax-number)"
			}
		},
		{
			"name": "function",
			"scope": [
				"entity.name.function",
				"support.function",
				"meta.function-call entity.name.function",
				"variable.function"
			],
			"settings": {
				"foreground": "var(--color-syntax-function)"
			}
		},
		{
			"name": "type",
			"scope": [
				"entity.name.type",
				"entity.name.class",
				"entity.name.namespace",
				"entity.other.inherited-class",
				"support.type",
				"support.class",
				"entity.name.tag",
				"entity.other.attribute-name",
				"support.type.property-name",
				"meta.type.annotation"
			],
			"settings": {
				"foreground": "var(--color-syntax-type)"
			}
		},
		{
			"name": "markup",
			"scope": ["markup.heading", "markup.bold"],
			"settings": {
				"fontStyle": "bold"
			}
		},
		{
			"name": "markup italic",
			"scope": ["markup.italic"],
			"settings": {
				"fontStyle": "italic"
			}
		}
	]
}
