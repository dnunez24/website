---
import type { HTMLAttributes } from "astro/types";

type Variant = "filled" | "outline" | "ghost";

/** `aria-current` value for a nav Button: `"page"` for the page itself, `"true"` for the section it sits in. */
type Current = "page" | "true";

type Props = {
	variant?: Variant;
	/** Marks this link current: `"page"` for an exact match, `"true"` for the section the page is in. Both show the same bold brand label over a rule. Ghost only. */
	current?: Current | undefined;
	class?: string;
} & (
	| ({ href: string } & Omit<HTMLAttributes<"a">, "class">)
	| ({ href?: undefined } & Omit<HTMLAttributes<"button">, "class">)
);

const {
	variant = "filled",
	current,
	href,
	class: className,
	...attrs
} = Astro.props;

// Each variant owns every property it sets, so no two classes on one element compete.
const variants: Record<Variant, string> = {
	filled:
		"border-brand bg-brand f6y-px-4 font-medium text-on-brand hover:border-brand-hover hover:bg-brand-hover",
	outline:
		"border-brand f6y-px-4 font-medium text-brand hover:bg-brand-tint hover:text-brand-hover",
	ghost: "relative border-transparent f6y-px-2 hover:bg-surface-hover",
};
// The rule is currentColor, so it always matches the label. Hover brings in
// the ground and fades the rule; the bold label still marks the page or
// section, whichever `current` says.
const ghostState = current
	? "font-bold text-brand after:absolute after:bottom-1 after:h-0.5 after:bg-current after:f6y-inset-x-2 after:transition-opacity hover:after:opacity-0"
	: "font-normal text-ink";

const classes = [
	"inline-flex cursor-pointer items-center justify-center gap-1 rounded-sm border f6y-py-2 font-mono text-label no-underline transition-colors-no-outline active:duration-64",
	variants[variant],
	variant === "ghost" && ghostState,
	className,
];
---

{
	href === undefined ? (
		<button
			type="button"
			aria-current={current}
			data-button
			class:list={classes}
			{...(attrs as Omit<HTMLAttributes<"button">, "class">)}
		>
			<slot />
		</button>
	) : (
		<a
			href={href}
			aria-current={current}
			data-button
			class:list={classes}
			{...(attrs as Omit<HTMLAttributes<"a">, "class">)}
		>
			<slot />
		</a>
	)
}
