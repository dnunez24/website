---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
	src?: ImageMetadata;
	alt: string;
	/** Float right inside the column; text wraps the circle. */
	float?: boolean;
}

const { src, alt, float = false } = Astro.props;
const circle =
	"block aspect-square w-full rounded-full bg-concrete-200 object-cover";
---

<figure
	class:list={[
		"m-0 w-3/10 max-w-portrait min-w-24",
		{ "float-right f6y-ms-4 f6y-mb-2 shape-circle": float },
	]}
>
	{
		src ? (
			<Image src={src} alt={alt} widths={[192, 384]} sizes="12rem" class={circle} />
		) : (
			<div role="img" aria-label={alt} class:list={[circle, "grid place-items-center font-mono text-label text-ink-muted"]}>
				Portrait
			</div>
		)
	}
</figure>
