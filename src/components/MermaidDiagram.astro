---
import { renderMermaidFigure } from "@lib/mermaid";

interface Props {
	/** Mermaid source. Name the diagram with `accTitle` and `accDescr`. */
	code: string;
}

const { code } = Astro.props;
// Rendered at build by the same renderer as Markdown fences, so both share
// one markup; components.css styles it.
const figure = await renderMermaidFigure(code);
---

<Fragment set:html={figure} />
