---
import type { HTMLAttributes, HTMLTag } from "astro/types";

interface Props extends HTMLAttributes<"h2"> {
	as?: HTMLTag;
}

// No top margin: preflight zeroes heading margins and the space above is the
// caller's to set. A value here would compete with the caller's class.
const { as: Tag = "h2", class: className, ...attrs } = Astro.props;
---

<Tag
	class:list={[
		"f6y-mb-2 font-mono text-label font-medium tracking-caps text-ink-muted uppercase",
		className,
	]}
	{...attrs}
><slot /></Tag>
