---
import type { Graph } from "schema-dts";

interface Props {
	data: Graph;
}

// Escaping `<` keeps a value like "</script>" from ending the element early.
const json = JSON.stringify(Astro.props.data).replaceAll("<", "\\u003c");
---

<script is:inline type="application/ld+json" set:html={json} />
