---
import { Code } from "astro:components";
import { fenceMeta, syntaxTheme, syntaxTransformers } from "@lib/syntax";
import type { ComponentProps } from "astro/types";

interface Props {
	code: string;
	lang: NonNullable<ComponentProps<typeof Code>["lang"]>;
	/** File name shown in the header bar. */
	file?: string;
	caption?: string;
}

const { code, lang, file, caption } = Astro.props;
// The frame (header, code, caption) comes from the `dn:code-frame`
// transformer, the one Markdown fences run, so both share one markup.
---

<Code
	code={code}
	lang={lang}
	meta={fenceMeta({ title: file, caption })}
	theme={syntaxTheme}
	transformers={syntaxTransformers}
/>
