---
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"a"> {}

const { href, class: className, ...props } = Astro.props;
const defaultClassNames =
	"text-mono leading-none f6y-exp-text-sm/base uppercase f6y-tracking-normal/wider decoration-none flex items-center content-center f6y-log-min-h-12/9 f6y-exp-py-3/2 f6y-exp-px-3/2 rounded-sm w-fit text-secondary font-medium hover:bg-surface-sunken aria-current:text-accent active:bg-concrete-400 motion-safe:transition-colors duration-fast ease-out";
---

<a href={href} class:list={[defaultClassNames, className]} {...props}>
	<slot />
</a>
