---
interface Props {
	name: string;
	tagline?: string;
	href?: string;
	class?: string;
}

const { name, tagline, href = "/", class: className } = Astro.props;
---

<a href={href} class:list={["group inline-flex flex-col rounded-sm text-ink-heading no-underline", className]}>
	<span class="text-h4 tracking-tight transition-colors group-hover:text-brand-hover">{name}</span>
	<!-- Below the measure breakpoint the name stands alone, so the header links fit beside it on every phone. -->
	{tagline && <span class="hidden font-mono text-label text-ink-muted measure:block">{tagline}</span>}
</a>
