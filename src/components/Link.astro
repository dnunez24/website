---
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"a"> {
	href: string;
	/** Defaults to true for absolute http(s) URLs. Adds the external mark. */
	external?: boolean;
}

const {
	href,
	external = /^https?:\/\//.test(href),
	class: className,
	...attrs
} = Astro.props;
---

<a
	href={href}
	rel={external ? "external" : undefined}
	class:list={[
		"rounded-sm text-link underline decoration-current decoration-2 underline-offset-2 transition-colors hover:text-link-hover hover:decoration-transparent focus-visible:text-link-hover focus-visible:decoration-transparent",
		{ "link-external": external },
		className,
	]}
	{...attrs}
><slot /></a>
