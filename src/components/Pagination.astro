---
import Button from "@components/Button.astro";

interface Props {
	current: number;
	total: number;
	/** URL for a page number. */
	href: (page: number) => string;
	label?: string;
}

const { current, total, href, label = "Pagination" } = Astro.props;

type Entry = { page: number } | { gap: true; key: string };

/** First, last, and the current page with one neighbor on each side; gaps between. */
function entries(): Entry[] {
	const pages = [...new Set([1, current - 1, current, current + 1, total])]
		.filter((page) => page >= 1 && page <= total)
		.sort((a, b) => a - b);
	const result: Entry[] = [];
	for (const [i, page] of pages.entries()) {
		const previous = pages[i - 1];
		if (previous !== undefined && page - previous > 1) {
			result.push({ gap: true, key: `gap-${page}` });
		}
		result.push({ page });
	}
	return result;
}

const cell = "f6y-min-w-8 tabular-nums";

// One row at every width, with the markup in visual order so focus moves left
// to right. Below the measure breakpoint seven page numbers and both direction
// links don't fit, so "Page 6 of 12" stands in for the numbers.
---

<nav aria-label={label} class="grid grid-cols-pagination items-center f6y-gap-2 f6y-py-4">
	<div class="justify-self-start bleed-s-2">
		{
			current > 1 && (
				<Button variant="ghost" href={href(current - 1)} rel="prev">
					<span aria-hidden="true">&lt;</span> Newer
				</Button>
			)
		}
	</div>
	<ol class="m-0 hidden list-none flex-wrap justify-center gap-0.5 p-0 measure:flex">
		{
			entries().map((entry) =>
				"gap" in entry ? (
					<li
						aria-hidden="true"
						class:list={[
							cell,
							"inline-flex items-center justify-center self-stretch font-mono text-label text-ink-muted",
						]}
					>
						…
					</li>
				) : (
					<li>
						<Button
							variant="ghost"
							href={href(entry.page)}
							current={entry.page === current}
							aria-label={`Page ${entry.page}`}
							class={cell}
						>
							{entry.page}
						</Button>
					</li>
				),
			)
		}
	</ol>
	<p class="m-0 font-mono text-label whitespace-nowrap text-ink-muted tabular-nums measure:hidden">
		Page {current} of {total}
	</p>
	<div class="justify-self-end bleed-e-2">
		{
			current < total && (
				<Button variant="ghost" href={href(current + 1)} rel="next">
					Older <span aria-hidden="true">&gt;</span>
				</Button>
			)
		}
	</div>
</nav>
