---
import Button from "@components/Button.astro";
import Container from "@components/Container.astro";
import WordMark from "@components/WordMark.astro";
import { HEADER_NAV_ITEMS, SITE_TAGLINE, SITE_TITLE } from "@constants";

const pathname = Astro.url.pathname;
const isCurrent = (href: string) =>
	pathname === href ||
	pathname.startsWith(href.endsWith("/") ? href : `${href}/`);
---

<header class="border-b border-line">
	<Container class="flex flex-wrap items-center justify-between f6y-gap-x-4 f6y-gap-y-2 f6y-py-2">
		<WordMark name={SITE_TITLE} tagline={SITE_TAGLINE} />
		<nav aria-label="Main">
			<ul class="m-0 flex list-none flex-wrap p-0 bleed-x-2">
				{
					HEADER_NAV_ITEMS.map((item) => (
						<li>
							<Button variant="ghost" href={item.href} current={isCurrent(item.href)}>
								{item.label}
							</Button>
						</li>
					))
				}
			</ul>
		</nav>
	</Container>
</header>
