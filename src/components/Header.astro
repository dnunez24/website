---
import NavLink from "@components/NavLink.astro";
import { SITE_TITLE } from "../consts";

const isActiveRoute = (name: string) => {
	const pathname = Astro.url.pathname.replace(import.meta.env.BASE_URL, "");
	console.log(pathname);
	return pathname === name;
};
---

<header class="py-16 px-4 border-border-subtle border-be">
  <nav class="flex items-center justify-between max-w-5xl w-full m-auto f6y-exp-px-4/12">
    <div class="">
      <h2 class="f6y-text-xl/2xl font-semibold tracking-tighter hover:text-accent motion-safe:transition-colors ease-out duration-slow "><a href="/">{SITE_TITLE}</a></h2>
      <div class="text-tertiary text-mono uppercase f6y-text-xs/sm">Engineering leadership & creative exploration</div>
    </div>
		<div class="flex">
			<NavLink href="/writing" aria-current={isActiveRoute("writing")}>Writing</NavLink>
			<NavLink href="/about" aria-current={isActiveRoute("about")}>About</NavLink>
		</div>
	</nav>
</header>
