---
import BaseHead from "@components/BaseHead.astro";
import Container from "@components/Container.astro";
import Footer from "@components/Footer.astro";
import Header from "@components/Header.astro";
import { isDevRoute } from "@lib/routes";
import type { ComponentProps } from "astro/types";

type Props = ComponentProps<typeof BaseHead>;

// Every /dev/* specimen, regardless of what builds it: the sitemap filter
// already excludes them, but a stray DN_DEV_PAGES=1 build should still ship
// them unindexable, not just unlisted.
const noindex = isDevRoute(Astro.url.pathname);
---

<html lang="en">
	<head>
		<BaseHead {...Astro.props} />
		{noindex && <meta name="robots" content="noindex" />}
		<!-- Structured data (JsonLd) from the page. -->
		<slot name="head" />
	</head>
	<body>
		<div class="flex min-h-dvh flex-col">
			<Header />
			<!-- One reading column on every page: children center in container-prose, text stays left-aligned. -->
			<!-- tabindex lets the skip link move focus here in every browser, not just scroll. main isn't a
			     control, so it takes no focus ring; the next Tab lands on its first link. -->
			<main id="main" tabindex="-1" class="flex-1 f6y-pt-8 focus:outline-none">
				<Container class="*:mx-auto *:max-w-measure">
					<slot />
				</Container>
			</main>
			<Footer />
		</div>
	</body>
</html>
