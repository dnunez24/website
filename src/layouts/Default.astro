---
import BaseHead from "@components/BaseHead.astro";
import Footer from "@components/Footer.astro";
import Header from "@components/Header.astro";
import type { MarkdownLayoutProps } from "astro";

interface FrontmatterProps {
	title: string;
	description: string;
	publishedDate: Date;
	prose?: boolean;
}

interface Props extends MarkdownLayoutProps<FrontmatterProps> {
	title?: string;
	description?: string;
	children: unknown;
}

const { description, frontmatter, title } = Astro.props;
const descriptionWithFallback = frontmatter?.description ?? description ?? "";
const titleWithFallback = frontmatter?.title ?? title ?? "";
const mainClassNames = "m-auto w-dvw max-w-5xl f6y-my-2/4 f6y-exp-px-4/12";
---

<html lang="en">
	<head>
		<BaseHead title={titleWithFallback} description={descriptionWithFallback} />
	</head>

	<body class="font-sans bg-surface-base text-primary transition-focus-ring flex flex-col gap-4">
		<Header />
		<main class:list={[mainClassNames, { typeset: frontmatter?.prose, "typeset-article": frontmatter?.prose }]}>
      <slot />
		</main>
		<Footer />
	</body>
</html>
