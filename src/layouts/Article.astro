---
import type { CollectionEntry } from "astro:content";
import FormattedDate from "@components/FormattedDate.astro";
import Prose from "@components/Prose.astro";
import TopicList from "@components/TopicList.astro";
import Base from "@layouts/Base.astro";
import { topicHref } from "@lib/writing";
import type { MarkdownLayoutProps } from "astro";

type ArticleData = CollectionEntry<"writing">["data"];
type Props = ArticleData | MarkdownLayoutProps<ArticleData>;

const props = Astro.props;
const {
	title,
	description,
	publishedDate,
	updatedDate,
	topics = [],
} = "frontmatter" in props ? props.frontmatter : props;
---

<Base title={title} description={description}>
	<article>
		<header class="f6y-mb-8">
			<h1 class="f6y-mt-2 f6y-mb-4 text-h1 text-balance text-ink-heading">{title}</h1>
			<div class="flex flex-wrap items-center f6y-gap-x-4 gap-y-1">
				<FormattedDate date={publishedDate} />
				{
					updatedDate && (
						<span class="font-mono text-label text-ink-muted">
							Updated <FormattedDate date={updatedDate} />
						</span>
					)
				}
				{topics.length > 0 && <TopicList topics={topics.map((name) => ({ name, href: topicHref(name) }))} />}
			</div>
		</header>
		<Prose>
			<slot />
		</Prose>
		{
			Astro.slots.has("footer") && (
				<footer class="f6y-mt-8 border-t border-line f6y-pt-4">
					<slot name="footer" />
				</footer>
			)
		}
	</article>
</Base>
