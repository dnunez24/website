---
import portrait from "@assets/blog-placeholder-about.jpg";
import JsonLd from "@components/JsonLd.astro";
import PageTitle from "@components/PageTitle.astro";
import Portrait from "@components/Portrait.astro";
import Prose from "@components/Prose.astro";
import Base from "@layouts/Base.astro";
import { profileGraph } from "@lib/seo";
---

<Base title="About" description="Who I am and what I do.">
	<JsonLd slot="head" data={profileGraph(Astro.site ?? Astro.url, Astro.url.pathname)} />
	<PageTitle>About</PageTitle>
	<div class="flow-root">
		<Portrait src={portrait} alt="Dave Nuñez" float loading="eager" />
		<Prose>
			<p>
				I lead software engineering teams and write about systems, people and craft.
			</p>
			<p>
				Placeholder copy. The final biography replaces this paragraph before the site
				goes live.
			</p>
		</Prose>
	</div>
</Base>
