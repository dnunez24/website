---
import JsonLd from "@components/JsonLd.astro";
import PageTitle from "@components/PageTitle.astro";
import WritingList from "@components/WritingList.astro";
import Base from "@layouts/Base.astro";
import { collectionGraph } from "@lib/seo";
import {
	articleHref,
	getArticles,
	paginateArticles,
	WRITING_PAGE_SIZE,
} from "@lib/writing";

// Page 1 always exists, even with zero articles.
const [page] = paginateArticles(await getArticles(), WRITING_PAGE_SIZE);
const articles = page.articles.map((article) => ({
	title: article.data.title,
	href: articleHref(article.id),
	date: article.data.publishedDate,
	summary: article.data.description,
}));
const title = "Writing";
const description = "Everything I have written, newest first.";
---

<Base title={title} description={description}>
	<JsonLd slot="head" data={collectionGraph(Astro.site ?? Astro.url, Astro.url.pathname, title, description)} />
	<PageTitle>Writing</PageTitle>
	<WritingList articles={articles} current={page.pageNumber} total={page.total} />
</Base>
