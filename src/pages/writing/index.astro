---
import ArticleList from "@components/ArticleList.astro";
import PageTitle from "@components/PageTitle.astro";
import Base from "@layouts/Base.astro";
import { articleHref, getArticles } from "@lib/writing";

const articles = (await getArticles()).map((article) => ({
	title: article.data.title,
	href: articleHref(article.id),
	date: article.data.publishedDate,
	summary: article.data.description,
}));
---

<Base title="Writing" description="Everything I have written, newest first.">
	<PageTitle>Writing</PageTitle>
	<ArticleList articles={articles} />
</Base>
