---
import ArticleList from "@components/ArticleList.astro";
import Intro from "@components/Intro.astro";
import JsonLd from "@components/JsonLd.astro";
import SectionTitle from "@components/SectionTitle.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "@constants";
import Base from "@layouts/Base.astro";
import { homeGraph } from "@lib/seo";
import { articleHref, getArticles } from "@lib/writing";

const articles = (await getArticles()).slice(0, 5).map((article) => ({
	title: article.data.title,
	href: articleHref(article.id),
	date: article.data.publishedDate,
}));
---

<Base title={SITE_TITLE} description={SITE_DESCRIPTION}>
	<JsonLd slot="head" data={homeGraph(Astro.site ?? Astro.url)} />
	<h1 class="sr-only">{SITE_TITLE}</h1>
	<Intro>{SITE_DESCRIPTION}</Intro>
	<section aria-labelledby="recent">
		<SectionTitle id="recent">Recent writing</SectionTitle>
		<ArticleList articles={articles} />
	</section>
</Base>
