---
import PageTitle from "@components/PageTitle.astro";
import TopicList from "@components/TopicList.astro";
import Base from "@layouts/Base.astro";
import { getTopics, topicHref } from "@lib/writing";

const topics = (await getTopics()).map(({ name, count }) => ({
	name,
	count,
	href: topicHref(name),
}));
---

<Base title="Topics" description="Every topic I write about, with its number of articles.">
	<PageTitle>Topics</PageTitle>
	<TopicList topics={topics} index />
</Base>
