{
	"$schema": "node_modules/@biomejs/biome/configuration_schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		// Vendored Vale styles.
		"includes": ["**", "!.vale"]
	},
	"css": {
		"parser": {
			"tailwindDirectives": true
		}
	},
	"javascript": {
		"globals": ["Astro"]
	},
	"linter": {
		"domains": {
			"astro": "all",
			"tailwind": "all"
		}
	},
	"overrides": [
		{
			// Ships byte-identical from the design system (public/favicon.svg):
			// browser chrome referenced via <link rel="icon">, never inlined into
			// a page's accessibility tree, so it carries no <title> of its own.
			"includes": ["public/favicon.svg"],
			"linter": {
				"rules": {
					"a11y": {
						"noSvgWithoutTitle": "off"
					}
				}
			}
		},
		{
			"includes": ["**/*.astro"],
			"linter": {
				"rules": {
					"correctness": {
						// [2026-09-08] Biome doesn't currently support these rules for
						// imports that cross language boundaries (JS to HTML). See
						// https://github.com/biomejs/biome/issues/2233 for details.
						"noUnusedVariables": "off",
						"noUnusedImports": "off"
					},
					"style": {
						// Same cause: components used only in the template look type-only.
						"useImportType": "off"
					}
				}
			}
		}
	]
}
